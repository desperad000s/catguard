#pragma code_page(65001)

// The lowest-numbered icon is the one Explorer shows for the exe.
1 ICON "catguard.ico"
2 ICON "tray-active.ico"
3 ICON "tray-paused.ico"

// RT_MANIFEST
1 24 "catguard.manifest"

1 VERSIONINFO
FILEVERSION 0,3,1,0
PRODUCTVERSION 0,3,1,0
FILEOS 0x40004
FILETYPE 0x1
{
  BLOCK "StringFileInfo"
  {
    BLOCK "040904B0"
    {
      VALUE "ProductName", "catguard"
      VALUE "FileDescription", "catguard"
      VALUE "CompanyName", "webseed OÜ"
      VALUE "LegalCopyright", "© 2026 webseed OÜ. MIT License."
      VALUE "OriginalFilename", "catguard.exe"
      VALUE "FileVersion", "0.3.1"
      VALUE "ProductVersion", "0.3.1"
    }
  }
  BLOCK "VarFileInfo" { VALUE "Translation", 0x0409, 0x04B0 }
}
